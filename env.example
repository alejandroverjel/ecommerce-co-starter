# ==============================================================================
# Variables de entorno
#
# Copiar a .env.local (desarrollo) o a /opt/tiendas/<tienda>/.env (servidor).
# En el servidor: chmod 600. Nunca entra a git.
# ==============================================================================

# --- Sitio ---
# Ápex o www, con esquema. Es la fuente de SITIO.dominio y de
# serverActions.allowedOrigins. El nombre de la tienda vive en
# tienda.config.ts, no aquí.
# EN DESARROLLO LOCAL cambiar a http://localhost:3000 (o al puerto que uses
# con `pnpm dev`): con el valor de ejemplo, Auth.js arma sus URLs de acción y
# de redirección (incluida la de después de iniciar sesión) contra
# example.com en vez de tu servidor local. En producción, el dominio real.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Base de datos ---
# En el servidor el host es "postgres": el nombre del servicio dentro de la
# red privada de esta tienda. No es alcanzable desde fuera.
# Usuario y base = el mismo valor que TIENDA (más abajo).
# La app solo lee process.env.DATABASE_URL (no lee Docker secrets): en el
# servidor esta URL debe llevar la misma contraseña real de
# secrets/db_password.txt, no un valor de relleno.
DATABASE_URL=postgresql://<tienda>:CAMBIAR@postgres:5432/<tienda>

# --- Auth.js ---
# Generar con: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Origen canonico del sitio. FIJARLO IMPORTA: sin el, Auth.js deduce la URL
# base de las cabeceras Host/X-Forwarded-* de cada peticion. Hoy lo tapan las
# reglas Host() de Traefik, pero un router catch-all futuro —o un acceso
# directo al puerto 3000 desde dentro de traefik-public— convertiria eso en un
# open redirect via ?callbackUrl= y en cookies emitidas sin el flag secure.
# EN DESARROLLO LOCAL cambiar a http://localhost:3000, igual que
# NEXT_PUBLIC_SITE_URL arriba: si no, el login redirige a example.com. En
# producción, el dominio real.
AUTH_URL=https://www.example.com

# --- Almacenamiento de imágenes ---
# Variable de SERVIDOR: en el contenedor de producción es la carpeta del
# volumen montado (ver Dockerfile y docker-compose.yml), no un directorio del
# proyecto. EN DESARROLLO LOCAL sin ese volumen, /data no existe (ni se puede
# crear en macOS): usar una carpeta del proyecto, p. ej. UPLOADS_DIR=./uploads
# (ya ignorada por /uploads/ en .gitignore).
UPLOADS_DIR=/data/uploads

# --- Google Search Console ---
# Vacía en desarrollo. Se documenta como variable de GitHub Actions más abajo.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Pagos ---
#
# LO NORMAL ES DEJAR ESTO VACÍO. Las llaves se guardan desde /admin/ajustes,
# cifradas en la base con PAYMENT_SECRETS_ENCRYPTION_KEY. Estas variables son
# solo un RESPALDO para arrancar sin panel; en cuanto hay valor en la base,
# manda la base.
#
# Ambas pasarelas usan checkout hospedado: los datos de tarjeta nunca pasan por
# este servidor, lo que mantiene el cumplimiento PCI fuera de nuestro alcance.

# Mercado Pago (principal). El access token es lo que autentica el cobro.
# Webhook a configurar en MP: https://www.example.com/api/pagos/mercadopago/
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Wompi (integrada, pendiente de llaves). La llave pública NO va aquí: se
# pega solo desde /admin/ajustes (ningún código lee una WOMPI_PUBLIC_KEY de
# entorno).
# Webhook a configurar en Wompi: https://www.example.com/api/pagos/wompi/
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# Clave para cifrar los secretos de pasarela guardados en la base de datos.
# Generar con: openssl rand -base64 32
PAYMENT_SECRETS_ENCRYPTION_KEY=

# --- Email transaccional ---
RESEND_API_KEY=
EMAIL_FROM=pedidos@example.com

# Obligatoria: sin ella no salen los avisos internos de pedidos (se registra
# el error con console.error y el correo al cliente sí sale igual). Nunca es
# el correo público de contacto (ese es tienda.config.ts contacto.correo).
EMAIL_TIENDA=
# Opcional: copia de los avisos internos.
EMAIL_COPIA=

# Secreto del endpoint de carritos abandonados (cron). Sin él, el endpoint no
# atiende ninguna petición.
# Generar con: openssl rand -hex 24
CRON_SECRET=

# --- Base de datos (opcional) ---
PGPOOL_MAX=
PG_APPLICATION_NAME=

# --- Seed (opcional; solo local o CI) ---
# Con 1, el seed crea 2 productos de demostración en la primera categoría
# inicial de tienda.config.ts.
SEED_DEMO=

# --- Cuenta de administración inicial ---
# El trigger prevent_role_escalation exige que quien cambia un rol YA sea
# admin, así que el primero no puede crearse desde la aplicación. Se crea a
# mano en el servidor, con node directo (la imagen no trae pnpm ni tsx):
#
#   docker compose exec -e ADMIN_EMAIL=admin@example.com -e ADMIN_NOMBRE="Admin" \
#     app node herramientas/crear-admin.cjs
#
# Si se definen aquí, el script las toma sin pasarlas por argumento.
ADMIN_EMAIL=
# Opcional: nombre del primer admin (por defecto "Administrador").
ADMIN_NOMBRE=

# --- Purga de caché de Cloudflare ---
# Las lee /opt/infra/scripts/purgar-cache.sh (repo vps-infra) desde el .env
# de esta tienda en el VPS. scripts/purgar-cache.sh de este repo no las lee:
# solo hace ssh y delega en ese script de la infra compartida.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# ==============================================================================
# Variables del contenedor (interpoladas por docker-compose.yml desde
# /opt/tiendas/<tienda>/.env)
# ==============================================================================
# Identificador corto de la tienda. Debe coincidir con el usuario y la base de
# DATABASE_URL de arriba.
TIENDA=
# Ápex del dominio, SIEMPRE sin esquema ni www (p. ej. example.com).
DOMINIO=
# Imagen publicada en el registro.
IMAGEN=ghcr.io/<owner>/<repo>:latest

# ==============================================================================
# Se hornean en build (variables de GitHub Actions, no van en este archivo)
# ==============================================================================
# NEXT_PUBLIC_SITE_URL
# NEXT_PUBLIC_GA_ID
# NEXT_PUBLIC_GTM_ID
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION

# ==============================================================================
# Solo en tu máquina, para `pnpm subir` (scripts/subir.sh) — no van en el
# servidor ni en este archivo, se exportan en tu entorno local
# ==============================================================================
# VPS=usuario@ip
# TIENDA=<mismo valor que arriba>
# DOMINIO=<mismo valor que arriba, ápex>
# URL_SITIO=https://www.<DOMINIO>   (opcional; por defecto https://www.$DOMINIO)
